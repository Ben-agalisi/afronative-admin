# Copy this file to .env and fill in your own values
# NEVER commit .env to Git — it contains secrets!

# Django Security
SECRET_KEY=generate-a-random-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database (SQLite for development, Postgres for production)
DATABASE_URL=sqlite:///db.sqlite3

# Cloudinary (sign up at cloudinary.com for free)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# API Security (random 32+ character secret — must match on Express side)
SITE_API_KEY=generate-a-random-32-character-key-here

# Admin URL path (change from default for security)
ADMIN_URL=afronative-admin/

# CSRF trusted origins (your Express site URL)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://your-express-site.onrender.com
