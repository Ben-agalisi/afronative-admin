# Copy this file to .env and fill in your own values
# NEVER commit .env to Git — it contains secrets!

# ============================================================================
# Django Security
# ============================================================================

# Generate a secure key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=generate-a-random-key-here

# Set to False for production!
DEBUG=False

# Comma-separated list of allowed hostnames (your domain, IP, etc.)
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ============================================================================
# Database — Supabase PostgreSQL
# ============================================================================

# Get your Supabase database connection string from:
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ============================================================================
# Cloudinary — Image Storage (sign up at cloudinary.com for free)
# ============================================================================

# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ============================================================================
# API Security — for Express frontend to fetch data from Django
# ============================================================================

# Generate a random 32+ character key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This key must match on your Express frontend side
SITE_API_KEY=generate-a-random-32-character-key-here

# ============================================================================
# Admin URL — change from default for security
# ============================================================================

ADMIN_URL=afronative-admin/

# ============================================================================
# CSRF Trusted Origins — your frontend site URLs
# ============================================================================

# Add your Express/frontend site URLs here (comma-separated, no spaces)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://your-express-site.onrender.com

# ============================================================================
# Production Server (Gunicorn)
# ============================================================================

# Bind address and port for Gunicorn (usually set by hosting platform)
# BIND=0.0.0.0:8000
# WORKERS=2
